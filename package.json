{
  "name": "etoro-bot",
  "version": "1.0.0",
  "description": "Automated eToro trading bot",
  "main": "src/index.js",
  "scripts": {
    "start": "concurrently --names \"bot,ui\" --prefix-colors \"cyan,magenta\" \"node src/index.js\" \"node src/ui/server.js\"",
    "start:docker": "concurrently --names \"bot,ui\" --prefix-colors \"cyan,magenta\" \"sh -c 'mkdir -p data/logs && node src/index.js 2>&1 | tee -a data/logs/bot.log'\" \"node src/ui/server.js\"",
    "start:bot": "node src/index.js",
    "start:ui": "node src/ui/server.js",
    "test": "jest --coverage --passWithNoTests",
    "encrypt": "node scripts/encrypt-password.js",
    "backtest": "node scripts/backtest.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "axios": "^1.7.0",
    "concurrently": "^8.2.0",
    "express": "^4.19.0",
    "express-session": "^1.18.0",
    "node-cron": "^3.0.3",
    "playwright": "^1.45.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
